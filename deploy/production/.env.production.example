# ==============================================================================
# Penpot 24/7 Production Environment Configuration
# ==============================================================================

# Target domain name for public traffic and ACME SSL cert issuance
PENPOT_DOMAIN=penpot.example.com
PENPOT_PUBLIC_URI=https://penpot.example.com
ACME_EMAIL=admin@example.com

# Strict loopback port binding (127.0.0.1). Set to 0.0.0.0 only on public edge servers.
PENPOT_HTTP_BIND=127.0.0.1
PENPOT_HTTPS_BIND=127.0.0.1
PENPOT_LOCAL_PORT=9001

# Penpot Image Version (e.g. 2.19, latest)
PENPOT_VERSION=2.19

# Secret key used to encrypt sessions and tokens.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PENPOT_SECRET_KEY=REPLACE_WITH_STRONG_RANDOM_SECRET_KEY_MIN_64_CHARS

# Database credentials
POSTGRES_USER=penpot
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD

# Penpot feature and behavior flags
# Options: enable-smtp, enable-backend-worker, enable-redis-cache, enable-mcp,
#          enable-admin-console, enable-registration, enable-login-with-google,
#          enable-login-with-github, enable-login-with-oidc, enable-login-with-ldap
PENPOT_FLAGS="enable-smtp enable-backend-worker enable-redis-cache enable-mcp"

# SMTP Email Configuration (Required for password resets, team invites, verification)
PENPOT_SMTP_DEFAULT_FROM=noreply@example.com
PENPOT_SMTP_DEFAULT_REPLY_TO=noreply@example.com
PENPOT_SMTP_HOST=smtp.sendgrid.net
PENPOT_SMTP_PORT=587
PENPOT_SMTP_USERNAME=apikey
PENPOT_SMTP_PASSWORD=your-smtp-api-key
PENPOT_SMTP_TLS=true
PENPOT_SMTP_SSL=false

# Object Storage Backend: fs (local docker volume) or s3 (AWS / MinIO / Cloudflare R2 / GCS)
PENPOT_OBJECTS_STORAGE_BACKEND=fs

# If using S3 compatible storage, configure the following:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# PENPOT_OBJECTS_STORAGE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# PENPOT_OBJECTS_STORAGE_S3_BUCKET=penpot-production-assets
# PENPOT_OBJECTS_STORAGE_S3_REGION=auto

# Telemetry (anonymous usage metrics)
PENPOT_TELEMETRY_ENABLED=false
